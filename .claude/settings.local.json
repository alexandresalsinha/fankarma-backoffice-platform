{
  "permissions": {
    "allow": [
      "Bash(env)",
      "Bash(npm --version)",
      "mcp__fanpagekarma__list_connected_profiles",
      "Bash(python *)",
      "Bash(curl -s http://localhost:4000/api/profiles)",
      "Bash(node -e 'let d=\"\";process.stdin.on\\(\"data\",c=>d+=c\\).on\\(\"end\",\\(\\)=>{const j=JSON.parse\\(d\\);console.log\\(\"total:\",j.total,\"| sample:\",j.profiles[0].profile_name,\"\\(\"+j.profiles[0].network+\"\\)\"\\)}\\)')",
      "Bash(curl -s http://localhost:4000/api/schema)",
      "Bash(node -e 'let d=\"\";process.stdin.on\\(\"data\",c=>d+=c\\).on\\(\"end\",\\(\\)=>{const j=JSON.parse\\(d\\);console.log\\(\"tools:\",j.tools.map\\(t=>t.name\\).join\\(\", \"\\)\\)}\\)')",
      "mcp__fanpagekarma__get_profile_metrics",
      "Skill(dataviz)",
      "WebFetch(domain:azure.microsoft.com)",
      "Bash(node -e ' *)",
      "Bash(curl -s -N -X POST http://localhost:4000/api/chat -H 'Content-Type: application/json' -d '{ *)",
      "Read(//tmp/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
